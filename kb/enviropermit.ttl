###  https://example.org/enviropermit#AirActivity
:AirActivity rdf:type owl:Class ;
             rdfs:subClassOf :SupportingActivity .


###  https://example.org/enviropermit#EmissionSource
:EmissionSource rdf:type owl:Class ;
                rdfs:subClassOf :Scope .


###  https://example.org/enviropermit#StationaryEmissionPoint
:StationaryEmissionPoint rdf:type owl:Class .


###  https://example.org/enviropermit#EmissionPertek
:EmissionPertek rdf:type owl:Class .


###  https://example.org/enviropermit#EmissionAssessment
:EmissionAssessment rdf:type owl:Class .


###  https://example.org/enviropermit#TechnicalEmissionChange
:TechnicalEmissionChange rdf:type owl:Class .


###  https://example.org/enviropermit#BoilerAddition
:BoilerAddition rdf:type owl:Class ;
                rdfs:subClassOf :TechnicalEmissionChange .


###  https://example.org/enviropermit#EmissionControlChange
:EmissionControlChange rdf:type owl:Class ;
                       rdfs:subClassOf :TechnicalEmissionChange .


###  https://example.org/enviropermit#FuelSwitchChange
:FuelSwitchChange rdf:type owl:Class ;
                  rdfs:subClassOf :TechnicalEmissionChange .


###  https://example.org/enviropermit#RegulatedStationaryEmission
:RegulatedStationaryEmission rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( :AirActivity
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty :emitsFrom ;
                                                                          owl:someValuesFrom :StationaryEmissionPoint
                                                                        ]
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty :isActivityOf ;
                                                                          owl:someValuesFrom :ScreenedCase
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                               owl:onProperty :activityObligation ;
                                               owl:hasValue :emission_pertek_required
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :activityObligation ;
                                               owl:hasValue :emission_slo_required
                                             ] ;
                             :source_id "P5:28-emisi" .


###  https://example.org/enviropermit#ExemptNonEmittingActivity
:ExemptNonEmittingActivity rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :AirActivity
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :hasEmissionAssessment ;
                                                                        owl:someValuesFrom [ owl:intersectionOf ( :EmissionAssessment
                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                    owl:onProperty :isNonEmittingSource ;
                                                                                                                    owl:hasValue "true"^^xsd:boolean
                                                                                                                  ]
                                                                                                                ) ;
                                                                                             rdf:type owl:Class
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :exemptFromDecision ;
                                             owl:hasValue :emission_obligation_status
                                           ] ;
                           owl:disjointWith :RegulatedStationaryEmission ;
                           :source_id "P5:28-emisi" .


###  https://example.org/enviropermit#MaintainedWaterPertekActivity
:MaintainedWaterPertekActivity rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( :RegulatedSurfaceDischarge
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty :hasCurrentPertek ;
                                                                            owl:someValuesFrom :WaterPertek
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty :hasTechnicalChange ;
                                                                            owl:allValuesFrom owl:Nothing
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                 owl:onProperty :satisfiesObligation ;
                                                 owl:hasValue :water_pertek_required
                                               ] ;
                               :source_id "MODEL:closure" ,
                                          "P5:15" ,
                                          "P5:3" .


###  https://example.org/enviropermit#MaintainedEmissionPertekActivity
:MaintainedEmissionPertekActivity rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( :RegulatedStationaryEmission
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasCurrentEmissionPertek ;
                                                                               owl:someValuesFrom :EmissionPertek
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasTechnicalChange ;
                                                                               owl:allValuesFrom owl:Nothing
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty :satisfiesObligation ;
                                                    owl:hasValue :emission_pertek_required
                                                  ] ;
                                  :source_id "MODEL:closure" ,
                                             "P5:28-emisi" ,
                                             "P5:40-emisi-perubahan" .


###  https://example.org/enviropermit#EmissionTechnicalRevision
:EmissionTechnicalRevision rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :AirActivity
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :emitsFrom ;
                                                                        owl:someValuesFrom :StationaryEmissionPoint
                                                                      ]
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :hasCurrentEmissionPertek ;
                                                                        owl:someValuesFrom :EmissionPertek
                                                                      ]
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :hasTechnicalChange ;
                                                                        owl:someValuesFrom :TechnicalEmissionChange
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :activityObligation ;
                                             owl:hasValue :amend_emission_pertek
                                           ] ;
                           :source_id "P5:40-emisi-perubahan" .


###  https://example.org/enviropermit#EmissionStudyBranch
:EmissionStudyBranch rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :EmissionTechnicalRevision
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :hasImpactAssessment ;
                                                                  owl:someValuesFrom [ owl:intersectionOf ( :ImpactAssessment
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty :extentChanges ;
                                                                                                              owl:hasValue "true"^^xsd:boolean
                                                                                                            ]
                                                                                                          ) ;
                                                                                       rdf:type owl:Class
                                                                                     ]
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :activityObligation ;
                                       owl:hasValue :prepare_emission_technical_study
                                     ] ;
                     owl:disjointWith :EmissionStandardBranch ;
                     :source_id "P5:29.2-emisi-kajian" .


###  https://example.org/enviropermit#EmissionStandardBranch
:EmissionStandardBranch rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :EmissionTechnicalRevision
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :hasImpactAssessment ;
                                                                     owl:someValuesFrom [ owl:intersectionOf ( :ImpactAssessment
                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                 owl:onProperty :extentChanges ;
                                                                                                                 owl:hasValue "false"^^xsd:boolean
                                                                                                               ]
                                                                                                             ) ;
                                                                                          rdf:type owl:Class
                                                                                        ]
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          owl:onProperty :activityObligation ;
                                          owl:hasValue :prepare_emission_standard_technical_documentation
                                        ] ;
                        :source_id "P5:29.3-emisi-standar" .


###  https://example.org/enviropermit#EmissionStudyAttachmentCandidate
:EmissionStudyAttachmentCandidate rdf:type owl:Class ;
                                  rdfs:subClassOf :ReviewableCandidate ;
                                  :source_id "MODEL:candidate-workflow" ,
                                             "P5:29.2-emisi-kajian" .


###  https://example.org/enviropermit#InteractingEmissionAmendments
:InteractingEmissionAmendments rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( :EnvironmentalAmendment
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty :hasActivity ;
                                                                            owl:someValuesFrom :EmissionTechnicalRevision
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasPlanEdge ;
                                                 owl:hasValue :emission_technical_issue_before_environmental_issue
                                               ] ;
                               :source_id "P5:28-emisi" ,
                                          "P5:40-emisi-perubahan" .


###  https://example.org/enviropermit#MultiMediaAmendmentScenario
:MultiMediaAmendmentScenario rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( :InteractingAmendments
                                                                        :InteractingEmissionAmendments
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             :source_id "P5:14" ,
                                        "P5:28-emisi" ,
                                        "PP22:89-90" .


