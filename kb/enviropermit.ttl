#################################################################
# Decision and evidence requirements — annotation metadata
# Absence requests evidence; it never proves a legal exemption.
#################################################################
:DecisionQuery a owl:Class .
:EvidenceRequirement a owl:Class .
:subjectClass a owl:AnnotationProperty .
:branchClass a owl:AnnotationProperty .
:missingEvidence a owl:AnnotationProperty .
:whenProperty a owl:AnnotationProperty .
:missingProperty a owl:AnnotationProperty .
:whenBooleanProperty a owl:AnnotationProperty .
:requiredBooleanProperty a owl:AnnotationProperty .
:changesInventoryComplete a owl:DatatypeProperty ; rdfs:range xsd:boolean .
:outsourcingClaim a owl:DatatypeProperty ; rdfs:range xsd:boolean .

:water_document_route a owl:NamedIndividual, :DecisionQuery ;
   :subjectClass :WaterTechnicalRevision ;
   :branchClass :TechnicalStudyBranch, :TechnicalStandardBranch ;
   :missingEvidence "impact_extent_assessment" .
:screening_evidence a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :Scenario ; :missingProperty :hasScreening ;
   :missingEvidence "proposed_activity_screening" .
:complete_inventory a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :Scenario ; :requiredBooleanProperty :changesInventoryComplete ;
   :missingEvidence "complete_project_change_inventory" .
:outsourcing_scope a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :Scenario ; :whenBooleanProperty :outsourcingClaim ;
   :missingEvidence "outsourced_wastewater_route_outside_verified_slice" .
:prior_pertek a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :WaterActivity ; :whenProperty :hasWaterTechnicalChange ;
   :missingProperty :hasCurrentPertek ;
   :missingEvidence "prior_water_pertek_or_initial_application_route" .
:screening_document_route a owl:NamedIndividual, :DecisionQuery ;
   :subjectClass :FoodManufacturingActivity ;
   :branchClass :ProtectedAreaActivity, :FoodManufacturingAmdalScale, :FoodManufacturingUklScale, :FoodManufacturingSpplScale ;
   :missingEvidence "screening_scale_or_location_evidence" .
:location_screening_evidence a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :FoodManufacturingActivity ; :missingProperty :hasLocationAssessment ;
   :missingEvidence "protected_area_location_verification" .
:scale_screening_evidence a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :FoodManufacturingActivity ; :missingProperty :hasScaleAssessment ;
   :missingEvidence "production_capacity_measurement" .
:boundary_ambiguity_gap a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :FoodManufacturingBoundaryAmbiguous ; :missingProperty :hasBoundaryClarification ;
   :missingEvidence "source_boundary_issue:P4:lampiran-i-pangan-batas:250_ton_per_year" .
:emission_obligation_status a owl:NamedIndividual, :DecisionQuery ;
   :subjectClass :AirActivity ;
   :branchClass :RegulatedStationaryEmission, :ExemptNonEmittingActivity ;
   :missingEvidence "stationary_emission_or_exemption_evidence" .
:emission_document_route a owl:NamedIndividual, :DecisionQuery ;
   :subjectClass :EmissionTechnicalRevision ;
   :branchClass :EmissionStudyBranch, :EmissionStandardBranch ;
   :missingEvidence "emission_impact_extent_assessment" .
:prior_emission_pertek a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :AirActivity ; :whenProperty :hasEmissionTechnicalChange ;
   :missingProperty :hasCurrentEmissionPertek ;
   :missingEvidence "prior_emission_pertek_or_initial_application_route" .

