:ruleId a owl:AnnotationProperty .
:caseId a owl:AnnotationProperty .

:provision_0 a owl:NamedIndividual, :Provision ;
 :source_id "PP22:89-90" ; :documentId "PP22_2021" ;
 :locator "Pasal 89(1), 89(2)(b),(h),(j), 90(1)-(3), 91" ;
 :sourceURL <https://jdih.kemenkoinfra.go.id/cfind/source/files/pp/2021/1.-salinan-pp-nomor-22-tahun-2021.pdf> ;
 :effectiveFrom "2021-02-02"^^xsd:date ; :provisionScope "environmental_approval_change" ; :reviewStatus "VERIFIED" ;
 :ruleId "EnvironmentalAmendment", "MultiMediaAmendmentScenario", "WithNewEnvironmentalDocumentation", "WithoutNewEnvironmentalDocumentation" ;
 :caseId "A", "B", "U", "M", "I", "X", "D", "C", "media_water_and_air" ;
 rdfs:comment "Environmental approval amendment; capacity increase needs the new-environmental-documentation route, while a complete set of encoded administrative/management changes follows the route without a new environmental document. The latter does not mean no paperwork or no approval. Mixed changes are not treated as administrative-only." .

:provision_1 a owl:NamedIndividual, :Provision ;
 :source_id "PP22:93.2" ; :documentId "PP22_2021" ;
 :locator "Pasal 93(2)" ;
 :sourceURL <https://jdih.kemenkoinfra.go.id/cfind/source/files/pp/2021/1.-salinan-pp-nomor-22-tahun-2021.pdf> ;
 :effectiveFrom "2021-02-02"^^xsd:date ; :provisionScope "environmental_approval_change" ; :reviewStatus "VERIFIED" ;
 :ruleId "ManagementTechnicalDependency" ;
 :caseId "M" ;
 rdfs:comment "Management/monitoring changes requiring technical approval are based on a technical approval change." .

:provision_2 a owl:NamedIndividual, :Provision ;
 :source_id "P5:3" ; :documentId "PERMEN_LHK_5_2021" ;
 :locator "Pasal 3(1)-(2)(a)" ;
 :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> ;
 :effectiveFrom "2021-04-01"^^xsd:date ; :provisionScope "wastewater_pertek" ; :reviewStatus "VERIFIED" ;
 :ruleId "MaintainedWaterPertekActivity", "RegulatedSurfaceDischarge" ;
 :caseId "A", "B", "U", "M", "I", "X", "D", "C" ;
 rdfs:comment "AMDAL/UKL-UPL activities conducting surface-water wastewater discharge must have technical approval and SLO. Obligation existence does not mean a new issuance is always needed or already satisfied." .

:provision_3 a owl:NamedIndividual, :Provision ;
 :source_id "P5:15" ; :documentId "PERMEN_LHK_5_2021" ;
 :locator "Pasal 15(1)-(2)" ;
 :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> ;
 :effectiveFrom "2021-04-01"^^xsd:date ; :provisionScope "wastewater_pertek" ; :reviewStatus "VERIFIED" ;
 :ruleId "InteractingAmendments", "MaintainedWaterPertekActivity", "WaterTechnicalRevision" ;
 :caseId "A", "B", "U", "M", "I", "X", "D", "C" ;
 rdfs:comment "Technical wastewater changes including treatment design and wastewater management require technical approval amendment. The spike assumes evidenced prior Pertek and a direct surface-water discharge route." .

:provision_4 a owl:NamedIndividual, :Provision ;
 :source_id "P5:16.1.a" ; :documentId "PERMEN_LHK_5_2021" ;
 :locator "Pasal 16(1)(a)" ;
 :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> ;
 :effectiveFrom "2021-04-01"^^xsd:date ; :provisionScope "wastewater_pertek" ; :reviewStatus "VERIFIED" ;
 :ruleId "TechnicalStudyAttachmentCandidate", "TechnicalStudyBranch", "water-study-candidate" ;
 :caseId "A", "D", "M", "X" ;
 rdfs:comment "Changed impact-spread extent leads to technical study attachment. The physical finding is input evidence, not predicted by OWL." .

:provision_5 a owl:NamedIndividual, :Provision ;
 :source_id "P5:16.1.b" ; :documentId "PERMEN_LHK_5_2021" ;
 :locator "Pasal 16(1)(b)" ;
 :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> ;
 :effectiveFrom "2021-04-01"^^xsd:date ; :provisionScope "wastewater_pertek" ; :reviewStatus "VERIFIED" ;
 :ruleId "TechnicalStandardBranch" ;
 :caseId "B" ;
 rdfs:comment "Explicit unchanged impact-spread extent leads to standards-compliance technical documentation. Unknown is not unchanged." .

:provision_6 a owl:NamedIndividual, :Provision ;
 :source_id "P5:16.2" ; :documentId "PERMEN_LHK_5_2021" ;
 :locator "Pasal 16(2)" ;
 :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> ;
 :effectiveFrom "2021-04-01"^^xsd:date ; :provisionScope "wastewater_pertek" ; :reviewStatus "VERIFIED" ;
 :ruleId "ConcurrentSubmissionPermitted", "UKLSubmissionSequence" ;
 :caseId "A", "B", "U", "M", "X", "D" ;
 rdfs:comment "Articles 8-12 apply mutatis mutandis to technical approval amendment." .

:provision_7 a owl:NamedIndividual, :Provision ;
 :source_id "P5:8.1" ; :documentId "PERMEN_LHK_5_2021" ;
 :locator "Pasal 8(1)" ;
 :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> ;
 :effectiveFrom "2021-04-01"^^xsd:date ; :provisionScope "wastewater_pertek" ; :reviewStatus "VERIFIED" ;
 :ruleId "ConcurrentSubmissionPermitted" ;
 :caseId "D" ;
 rdfs:comment "AMDAL technical application can be concurrent with or precede environmental application; no strict before-only rule." .

:provision_8 a owl:NamedIndividual, :Provision ;
 :source_id "P5:8.2" ; :documentId "PERMEN_LHK_5_2021" ;
 :locator "Pasal 8(2)" ;
 :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> ;
 :effectiveFrom "2021-04-01"^^xsd:date ; :provisionScope "wastewater_pertek" ; :reviewStatus "VERIFIED" ;
 :ruleId "UKLSubmissionSequence" ;
 :caseId "A", "B", "U", "M", "X" ;
 rdfs:comment "UKL-UPL technical application precedes environmental application. Application is distinguished from issuance." .

:provision_9 a owl:NamedIndividual, :Provision ;
 :source_id "P5:14" ; :documentId "PERMEN_LHK_5_2021" ;
 :locator "Pasal 14(1)" ;
 :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> ;
 :effectiveFrom "2021-04-01"^^xsd:date ; :provisionScope "wastewater_pertek" ; :reviewStatus "VERIFIED" ;
 :ruleId "InteractingAmendments", "MultiMediaAmendmentScenario" ;
 :caseId "A", "B", "U", "M", "X", "D", "media_water_and_air" ;
 rdfs:comment "Technical approval is a prerequisite for environmental approval issuance. Not a claim that every technical approval must be issued before environmental application." .

:provision_10 a owl:NamedIndividual, :Provision ;
 :source_id "MODEL:closure" ; :documentId "MODEL_ASSUMPTION" ;
 :locator "Modeling assumption, not legislation" ;
 :provisionScope "modeling_assumption" ; :reviewStatus "MODEL_ASSUMPTION" ;
 :ruleId "MaintainedEmissionPertekActivity", "MaintainedWaterPertekActivity", "WithoutNewEnvironmentalDocumentation" ;
 :caseId "I", "M", "X", "media_existing_emission_pertek" ;
 rdfs:comment "Universal closure over project changes is asserted only if the fixture explicitly certifies a complete inventory. Open-world absence does not establish exclusivity." .

:provision_11 a owl:NamedIndividual, :Provision ;
 :source_id "MODEL:screening" ; :documentId "MODEL_ASSUMPTION" ;
 :locator "Modeling assumption, not legislation" ;
 :provisionScope "modeling_assumption" ; :reviewStatus "MODEL_ASSUMPTION" ;
 :ruleId "ScreenedCase" ;
 :caseId "A", "B", "U", "M", "X", "D", "C" ;
 rdfs:comment "Proposed-project AMDAL/UKL screening is supplied as a hypothetical verified input. Historical approval does not automatically establish the changed project's regime." .

:candidate_workflow_source a owl:NamedIndividual, :Provision ;
 :source_id "MODEL:candidate-workflow" ; :documentId "MODEL_ASSUMPTION" ;
 :locator "Modeling assumption, not legislation" ;
 :provisionScope "modeling_assumption" ; :reviewStatus "MODEL_ASSUMPTION" ;
 :ruleId "EmissionStudyAttachmentCandidate", "TechnicalStudyAttachmentCandidate", "emission-study-candidate", "water-study-candidate" ;
 :caseId "A", "D", "M", "X", "media_water_and_air" ;
 rdfs:comment "Persiapan kandidat bernama untuk review, bukan bukti pemenuhan atau penerbitan." .

