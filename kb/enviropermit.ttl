#################################################################
# SWRL rules — edit in Protege Rules tab; never sent to HermiT
#################################################################
swrla:isRuleEnabled a owl:AnnotationProperty .
:activity a swrl:Variable .
:candidate a swrl:Variable .
[] a swrl:Imp ;
   rdfs:label "water-study-candidate" ;
   rdfs:comment "Kandidat lampiran kajian teknis untuk review, bukan dokumen yang sudah diterbitkan." ;
   :source_id "P5:16.1.a", "MODEL:candidate-workflow" ;
   swrla:isRuleEnabled true ;
   swrl:body (
     [ a swrl:ClassAtom ; swrl:classPredicate :TechnicalStudyBranch ; swrl:argument1 :activity ]
     [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasStudyCandidate ; swrl:argument1 :activity ; swrl:argument2 :candidate ]
   ) ;
   swrl:head (
     [ a swrl:ClassAtom ; swrl:classPredicate :TechnicalStudyAttachmentCandidate ; swrl:argument1 :candidate ]
   ) .

#################################################################
# Decision and evidence requirements — annotation metadata
# Absence requests evidence; it never proves a legal exemption.
#################################################################
:DecisionQuery a owl:Class .
:EvidenceRequirement a owl:Class .
:subjectClass a owl:AnnotationProperty .
:branchClass a owl:AnnotationProperty .
:missingEvidence a owl:AnnotationProperty .
:whenProperty a owl:AnnotationProperty .
:missingProperty a owl:AnnotationProperty .
:whenBooleanProperty a owl:AnnotationProperty .
:requiredBooleanProperty a owl:AnnotationProperty .
:changesInventoryComplete a owl:DatatypeProperty ; rdfs:range xsd:boolean .
:outsourcingClaim a owl:DatatypeProperty ; rdfs:range xsd:boolean .

:water_document_route a owl:NamedIndividual, :DecisionQuery ;
   :subjectClass :WaterTechnicalRevision ;
   :branchClass :TechnicalStudyBranch, :TechnicalStandardBranch ;
   :missingEvidence "impact_extent_assessment" .
:screening_evidence a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :Scenario ; :missingProperty :hasScreening ;
   :missingEvidence "proposed_activity_screening" .
:complete_inventory a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :Scenario ; :requiredBooleanProperty :changesInventoryComplete ;
   :missingEvidence "complete_project_change_inventory" .
:outsourcing_scope a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :Scenario ; :whenBooleanProperty :outsourcingClaim ;
   :missingEvidence "outsourced_wastewater_route_outside_verified_slice" .
:prior_pertek a owl:NamedIndividual, :EvidenceRequirement ;
   :subjectClass :WaterActivity ; :whenProperty :hasWaterTechnicalChange ;
   :missingProperty :hasCurrentPertek ;
   :missingEvidence "prior_water_pertek_or_initial_application_route" .

#################################################################
# Sources and interpretation notes inherited from the spike
#################################################################
:Provision a owl:Class .
:locator a owl:AnnotationProperty .
:sourceURL a owl:AnnotationProperty .
:provision_0 a owl:NamedIndividual, :Provision ;
 :source_id "PP22:89-90" ; :locator "Pasal 89(1), 89(2)(b),(h),(j), 90(1)-(3), 91" ;
 rdfs:comment "Environmental approval amendment; capacity increase needs the new-environmental-documentation route, while a complete set of encoded administrative/management changes follows the route without a new environmental document. The latter does not mean no paperwork or no approval. Mixed changes are not treated as administrative-only." ; :sourceURL <https://jdih.kemenkoinfra.go.id/cfind/source/files/pp/2021/1.-salinan-pp-nomor-22-tahun-2021.pdf> .
:provision_1 a owl:NamedIndividual, :Provision ;
 :source_id "PP22:93.2" ; :locator "Pasal 93(2)" ;
 rdfs:comment "Management/monitoring changes requiring technical approval are based on a technical approval change." ; :sourceURL <https://jdih.kemenkoinfra.go.id/cfind/source/files/pp/2021/1.-salinan-pp-nomor-22-tahun-2021.pdf> .
:provision_2 a owl:NamedIndividual, :Provision ;
 :source_id "P5:3" ; :locator "Pasal 3(1)-(2)(a)" ;
 rdfs:comment "AMDAL/UKL-UPL activities conducting surface-water wastewater discharge must have technical approval and SLO. Obligation existence does not mean a new issuance is always needed or already satisfied." ; :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> .
:provision_3 a owl:NamedIndividual, :Provision ;
 :source_id "P5:15" ; :locator "Pasal 15(1)-(2)" ;
 rdfs:comment "Technical wastewater changes including treatment design and wastewater management require technical approval amendment. The spike assumes evidenced prior Pertek and a direct surface-water discharge route." ; :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> .
:provision_4 a owl:NamedIndividual, :Provision ;
 :source_id "P5:16.1.a" ; :locator "Pasal 16(1)(a)" ;
 rdfs:comment "Changed impact-spread extent leads to technical study attachment. The physical finding is input evidence, not predicted by OWL." ; :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> .
:provision_5 a owl:NamedIndividual, :Provision ;
 :source_id "P5:16.1.b" ; :locator "Pasal 16(1)(b)" ;
 rdfs:comment "Explicit unchanged impact-spread extent leads to standards-compliance technical documentation. Unknown is not unchanged." ; :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> .
:provision_6 a owl:NamedIndividual, :Provision ;
 :source_id "P5:16.2" ; :locator "Pasal 16(2)" ;
 rdfs:comment "Articles 8-12 apply mutatis mutandis to technical approval amendment." ; :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> .
:provision_7 a owl:NamedIndividual, :Provision ;
 :source_id "P5:8.1" ; :locator "Pasal 8(1)" ;
 rdfs:comment "AMDAL technical application can be concurrent with or precede environmental application; no strict before-only rule." ; :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> .
:provision_8 a owl:NamedIndividual, :Provision ;
 :source_id "P5:8.2" ; :locator "Pasal 8(2)" ;
 rdfs:comment "UKL-UPL technical application precedes environmental application. Application is distinguished from issuance." ; :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> .
:provision_9 a owl:NamedIndividual, :Provision ;
 :source_id "P5:14" ; :locator "Pasal 14(1)" ;
 rdfs:comment "Technical approval is a prerequisite for environmental approval issuance. Not a claim that every technical approval must be issued before environmental application." ; :sourceURL <https://jdih.menlhk.go.id/new/uploads/files/2021pmlhk005_menlhk_06082021104129.pdf> .
:provision_10 a owl:NamedIndividual, :Provision ;
 :source_id "MODEL:closure" ; :locator "Modeling assumption, not legislation" ;
 rdfs:comment "Universal closure over project changes is asserted only if the fixture explicitly certifies a complete inventory. Open-world absence does not establish exclusivity." .
:provision_11 a owl:NamedIndividual, :Provision ;
 :source_id "MODEL:screening" ; :locator "Modeling assumption, not legislation" ;
 rdfs:comment "Proposed-project AMDAL/UKL screening is supplied as a hypothetical verified input. Historical approval does not automatically establish the changed project's regime." .
:candidate_workflow_source a owl:NamedIndividual, :Provision ; :source_id "MODEL:candidate-workflow" ; rdfs:comment "Persiapan kandidat bernama untuk review, bukan bukti pemenuhan atau penerbitan." .
