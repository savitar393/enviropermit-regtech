#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Activity
                :Assessment
                :EvidenceSnapshot
                :ObligationCandidate
                :Project
                :Scenario
              )
] .


