@prefix : <https://example.org/enviropermit#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://example.org/enviropermit#> .

<https://example.org/enviropermit/core/t1> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  https://example.org/enviropermit#source_id
:source_id rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://example.org/enviropermit#activityObligation
:activityObligation rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#assessesScenario
:assessesScenario rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#dischargesTo
:dischargesTo rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#edgeAfter
:edgeAfter rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#edgeBefore
:edgeBefore rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasActivity
:hasActivity rdf:type owl:ObjectProperty ;
             owl:inverseOf :isActivityOf .


###  https://example.org/enviropermit#hasAssessment
:hasAssessment rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasCurrentPertek
:hasCurrentPertek rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasExistingApproval
:hasExistingApproval rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasImpactAssessment
:hasImpactAssessment rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasPlanEdge
:hasPlanEdge rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasProjectChange
:hasProjectChange rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasScenario
:hasScenario rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasScreening
:hasScreening rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasSnapshot
:hasSnapshot rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasStudyCandidate
:hasStudyCandidate rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasTechnicalChange
:hasTechnicalChange rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasWaterTechnicalChange
:hasWaterTechnicalChange rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasTechnicalChange .


###  https://example.org/enviropermit#isActivityOf
:isActivityOf rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#ofSubject
:ofSubject rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#onScope
:onScope rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#projectObligation
:projectObligation rdf:type owl:ObjectProperty ;
                   owl:propertyChainAxiom ( :hasScenario
                                            :scenarioObligation
                                          ) .


###  https://example.org/enviropermit#requiresStep
:requiresStep rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty .


###  https://example.org/enviropermit#scenarioObligation
:scenarioObligation rdf:type owl:ObjectProperty ;
                    owl:propertyChainAxiom ( :hasActivity
                                             :activityObligation
                                           ) .


###  https://example.org/enviropermit#activityScreening
:activityScreening rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasBoundaryClarification
:hasBoundaryClarification rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasLocationAssessment
:hasLocationAssessment rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasScaleAssessment
:hasScaleAssessment rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#emitsFrom
:emitsFrom rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#exemptFromDecision
:exemptFromDecision rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasCurrentEmissionPertek
:hasCurrentEmissionPertek rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasEmissionAssessment
:hasEmissionAssessment rdf:type owl:ObjectProperty .


###  https://example.org/enviropermit#hasEmissionTechnicalChange
:hasEmissionTechnicalChange rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf :hasTechnicalChange .


###  https://example.org/enviropermit#satisfiesObligation
:satisfiesObligation rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://example.org/enviropermit#extentChanges
:extentChanges rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:range xsd:boolean .


###  https://example.org/enviropermit#isNonEmittingSource
:isNonEmittingSource rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:range xsd:boolean .


###  https://example.org/enviropermit#hasLandAreaHa
:hasLandAreaHa rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:range xsd:decimal .


###  https://example.org/enviropermit#hasProductionCapacityTonPerYear
:hasProductionCapacityTonPerYear rdf:type owl:DatatypeProperty ,
                                          owl:FunctionalProperty ;
                                 rdfs:range xsd:decimal .


###  https://example.org/enviropermit#hasProtectedAreaException
:hasProtectedAreaException rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:range xsd:boolean .


###  https://example.org/enviropermit#hasWastewaterFlowM3PerDay
:hasWastewaterFlowM3PerDay rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:range xsd:decimal .


###  https://example.org/enviropermit#inProtectedArea
:inProtectedArea rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:range xsd:boolean .


#################################################################
#    Classes
#################################################################

###  https://example.org/enviropermit#Activity
:Activity rdf:type owl:Class .


###  https://example.org/enviropermit#Assessment
:Assessment rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :assessesScenario ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Scenario
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasSnapshot ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :EvidenceSnapshot
                            ] .


###  https://example.org/enviropermit#CapacityIncrease
:CapacityIncrease rdf:type owl:Class ;
                  rdfs:subClassOf :NewDocChange .


###  https://example.org/enviropermit#ConcurrentSubmissionPermitted
:ConcurrentSubmissionPermitted rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( :InteractingAmendments
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty :hasScreening ;
                                                                            owl:hasValue :AMDAL
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               :source_id "P5:16.2" ,
                                          "P5:8.1" .


###  https://example.org/enviropermit#EnvironmentalAmendment
:EnvironmentalAmendment rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :Scenario
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :hasExistingApproval ;
                                                                     owl:someValuesFrom :EnvironmentalApproval
                                                                   ]
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :hasProjectChange ;
                                                                     owl:someValuesFrom :ProjectChange
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          owl:onProperty :scenarioObligation ;
                                          owl:hasValue :amend_environmental_approval
                                        ] ;
                        :source_id "PP22:89-90" .


###  https://example.org/enviropermit#EnvironmentalApproval
:EnvironmentalApproval rdf:type owl:Class .


###  https://example.org/enviropermit#EvidenceSnapshot
:EvidenceSnapshot rdf:type owl:Class .


###  https://example.org/enviropermit#IdentityChange
:IdentityChange rdf:type owl:Class ;
                rdfs:subClassOf :NoNewDocChange .


###  https://example.org/enviropermit#ImpactAssessment
:ImpactAssessment rdf:type owl:Class .


###  https://example.org/enviropermit#InteractingAmendments
:InteractingAmendments rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :EnvironmentalAmendment
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :hasActivity ;
                                                                    owl:someValuesFrom :WaterTechnicalRevision
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasPlanEdge ;
                                         owl:hasValue :technical_issue_before_environmental_issue
                                       ] ;
                       :source_id "P5:14" ,
                                  "P5:15" .


###  https://example.org/enviropermit#MainActivity
:MainActivity rdf:type owl:Class ;
              rdfs:subClassOf :Activity .


###  https://example.org/enviropermit#ManagementMonitoringChange
:ManagementMonitoringChange rdf:type owl:Class ;
                            rdfs:subClassOf :NoNewDocChange .


###  https://example.org/enviropermit#ManagementTechnicalDependency
:ManagementTechnicalDependency rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( :WithoutNewEnvironmentalDocumentation
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty :hasActivity ;
                                                                            owl:someValuesFrom :WaterTechnicalRevision
                                                                          ]
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty :hasProjectChange ;
                                                                            owl:someValuesFrom :ManagementMonitoringChange
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               :source_id "PP22:93.2" .


###  https://example.org/enviropermit#NewDocChange
:NewDocChange rdf:type owl:Class ;
              rdfs:subClassOf :ProjectChange ;
              owl:disjointWith :NoNewDocChange .


###  https://example.org/enviropermit#NoNewDocChange
:NoNewDocChange rdf:type owl:Class ;
                rdfs:subClassOf :ProjectChange .


###  https://example.org/enviropermit#ObligationCandidate
:ObligationCandidate rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasAssessment ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Assessment
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :ofSubject ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Activity
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :onScope ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Scope
                                     ] .


###  https://example.org/enviropermit#ObligationKind
:ObligationKind rdf:type owl:Class .


###  https://example.org/enviropermit#PlanEdge
:PlanEdge rdf:type owl:Class .


###  https://example.org/enviropermit#Project
:Project rdf:type owl:Class .


###  https://example.org/enviropermit#ProjectChange
:ProjectChange rdf:type owl:Class .


###  https://example.org/enviropermit#RegulatedSurfaceDischarge
:RegulatedSurfaceDischarge rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :WaterActivity
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :dischargesTo ;
                                                                        owl:someValuesFrom :SurfaceWater
                                                                      ]
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :isActivityOf ;
                                                                        owl:someValuesFrom :ScreenedCase
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :activityObligation ;
                                             owl:hasValue :water_pertek_required
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :activityObligation ;
                                             owl:hasValue :water_slo_required
                                           ] ;
                           :source_id "P5:3" .


###  https://example.org/enviropermit#ReviewableCandidate
:ReviewableCandidate rdf:type owl:Class ;
                     rdfs:subClassOf :ObligationCandidate .


###  https://example.org/enviropermit#Scenario
:Scenario rdf:type owl:Class .


###  https://example.org/enviropermit#Scope
:Scope rdf:type owl:Class .


###  https://example.org/enviropermit#ScreenedCase
:ScreenedCase rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Scenario
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :hasScreening ;
                                                           owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                owl:oneOf ( :AMDAL
                                                                                            :UKL
                                                                                          )
                                                                              ]
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              :source_id "MODEL:screening" .


###  https://example.org/enviropermit#Screening
:Screening rdf:type owl:Class .


###  https://example.org/enviropermit#StepKind
:StepKind rdf:type owl:Class .


###  https://example.org/enviropermit#SupportingActivity
:SupportingActivity rdf:type owl:Class ;
                    rdfs:subClassOf :Activity .


###  https://example.org/enviropermit#SurfaceWater
:SurfaceWater rdf:type owl:Class .


###  https://example.org/enviropermit#TechnicalStandardBranch
:TechnicalStandardBranch rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :WaterTechnicalRevision
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasImpactAssessment ;
                                                                      owl:someValuesFrom [ owl:intersectionOf ( :ImpactAssessment
                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                  owl:onProperty :extentChanges ;
                                                                                                                  owl:hasValue "false"^^xsd:boolean
                                                                                                                ]
                                                                                                              ) ;
                                                                                           rdf:type owl:Class
                                                                                         ]
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty :activityObligation ;
                                           owl:hasValue :prepare_standard_technical_documentation
                                         ] ;
                         owl:disjointWith :TechnicalStudyBranch ;
                         :source_id "P5:16.1.b" .


###  https://example.org/enviropermit#TechnicalStudyAttachmentCandidate
:TechnicalStudyAttachmentCandidate rdf:type owl:Class ;
                                   rdfs:subClassOf :ReviewableCandidate ;
                                   :source_id "MODEL:candidate-workflow" ,
                                              "P5:16.1.a" .


###  https://example.org/enviropermit#TechnicalStudyBranch
:TechnicalStudyBranch rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :WaterTechnicalRevision
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasImpactAssessment ;
                                                                   owl:someValuesFrom [ owl:intersectionOf ( :ImpactAssessment
                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                               owl:onProperty :extentChanges ;
                                                                                                               owl:hasValue "true"^^xsd:boolean
                                                                                                             ]
                                                                                                           ) ;
                                                                                        rdf:type owl:Class
                                                                                      ]
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty :activityObligation ;
                                        owl:hasValue :prepare_technical_study
                                      ] ;
                      :source_id "P5:16.1.a" .


###  https://example.org/enviropermit#TechnicalWaterChange
:TechnicalWaterChange rdf:type owl:Class .


###  https://example.org/enviropermit#TreatmentDesignChange
:TreatmentDesignChange rdf:type owl:Class ;
                       rdfs:subClassOf :TechnicalWaterChange .


###  https://example.org/enviropermit#UKLSubmissionSequence
:UKLSubmissionSequence rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :InteractingAmendments
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :hasScreening ;
                                                                    owl:hasValue :UKL
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasPlanEdge ;
                                         owl:hasValue :ukl_application_order
                                       ] ;
                       :source_id "P5:16.2" ,
                                  "P5:8.2" .


###  https://example.org/enviropermit#WastewaterManagementChange
:WastewaterManagementChange rdf:type owl:Class ;
                            rdfs:subClassOf :TechnicalWaterChange .


###  https://example.org/enviropermit#WastewaterOutlet
:WastewaterOutlet rdf:type owl:Class ;
                  rdfs:subClassOf :Scope .


###  https://example.org/enviropermit#WaterActivity
:WaterActivity rdf:type owl:Class ;
               rdfs:subClassOf :SupportingActivity .


###  https://example.org/enviropermit#WaterPertek
:WaterPertek rdf:type owl:Class .


###  https://example.org/enviropermit#WaterTechnicalRevision
:WaterTechnicalRevision rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :WaterActivity
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :dischargesTo ;
                                                                     owl:someValuesFrom :SurfaceWater
                                                                   ]
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :hasCurrentPertek ;
                                                                     owl:someValuesFrom :WaterPertek
                                                                   ]
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :hasTechnicalChange ;
                                                                     owl:someValuesFrom :TechnicalWaterChange
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          owl:onProperty :activityObligation ;
                                          owl:hasValue :amend_water_pertek
                                        ] ;
                        :source_id "P5:15" .


###  https://example.org/enviropermit#WithNewEnvironmentalDocumentation
:WithNewEnvironmentalDocumentation rdf:type owl:Class ;
                                   owl:equivalentClass [ owl:intersectionOf ( :EnvironmentalAmendment
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty :hasProjectChange ;
                                                                                owl:someValuesFrom :NewDocChange
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] ;
                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty :scenarioObligation ;
                                                     owl:hasValue :prepare_new_environmental_documentation
                                                   ] ;
                                   owl:disjointWith :WithoutNewEnvironmentalDocumentation ;
                                   :source_id "PP22:89-90" .


###  https://example.org/enviropermit#WithoutNewEnvironmentalDocumentation
:WithoutNewEnvironmentalDocumentation rdf:type owl:Class ;
                                      owl:equivalentClass [ owl:intersectionOf ( :EnvironmentalAmendment
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :hasProjectChange ;
                                                                                   owl:someValuesFrom :NoNewDocChange
                                                                                 ]
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :hasProjectChange ;
                                                                                   owl:allValuesFrom :NoNewDocChange
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                      :source_id "MODEL:closure" ,
                                                 "PP22:89-90" .


###  https://example.org/enviropermit#FoodManufacturingActivity
:FoodManufacturingActivity rdf:type owl:Class ;
                           rdfs:subClassOf :MainActivity .


###  https://example.org/enviropermit#LocationAssessment
:LocationAssessment rdf:type owl:Class .


###  https://example.org/enviropermit#ScaleAssessment
:ScaleAssessment rdf:type owl:Class .


###  https://example.org/enviropermit#LocationClearedForScaleScreening
:LocationClearedForScaleScreening rdf:type owl:Class .


###  https://example.org/enviropermit#OutsideProtectedAreaActivity
:OutsideProtectedAreaActivity rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( :MainActivity
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty :hasLocationAssessment ;
                                                                           owl:someValuesFrom [ owl:intersectionOf ( :LocationAssessment
                                                                                                                     [ rdf:type owl:Restriction ;
                                                                                                                       owl:onProperty :inProtectedArea ;
                                                                                                                       owl:hasValue "false"^^xsd:boolean
                                                                                                                     ]
                                                                                                                   ) ;
                                                                                                rdf:type owl:Class
                                                                                              ]
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:subClassOf :LocationClearedForScaleScreening ;
                              :source_id "P4:pasal-3-lokasi-lindung" .


###  https://example.org/enviropermit#ProtectedAreaActivity
:ProtectedAreaActivity rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :MainActivity
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :hasLocationAssessment ;
                                                                    owl:someValuesFrom [ owl:intersectionOf ( :LocationAssessment
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty :inProtectedArea ;
                                                                                                                owl:hasValue "true"^^xsd:boolean
                                                                                                              ]
                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                owl:onProperty :hasProtectedAreaException ;
                                                                                                                owl:hasValue "false"^^xsd:boolean
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ]
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :activityScreening ;
                                         owl:hasValue :AMDAL
                                       ] ;
                       owl:disjointWith :LocationClearedForScaleScreening ;
                       :source_id "P4:pasal-3-lokasi-lindung" .


###  https://example.org/enviropermit#ProtectedAreaExemptActivity
:ProtectedAreaExemptActivity rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( :MainActivity
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty :hasLocationAssessment ;
                                                                          owl:someValuesFrom [ owl:intersectionOf ( :LocationAssessment
                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                      owl:onProperty :inProtectedArea ;
                                                                                                                      owl:hasValue "true"^^xsd:boolean
                                                                                                                    ]
                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                      owl:onProperty :hasProtectedAreaException ;
                                                                                                                      owl:hasValue "true"^^xsd:boolean
                                                                                                                    ]
                                                                                                                  ) ;
                                                                                               rdf:type owl:Class
                                                                                             ]
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf :LocationClearedForScaleScreening ;
                             :source_id "P4:pasal-4-pengecualian-lindung" .


###  https://example.org/enviropermit#FoodManufacturingSpplScale
:FoodManufacturingSpplScale rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( :FoodManufacturingActivity
                                                                       :LocationClearedForScaleScreening
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasProductionCapacityTonPerYear ;
                                                                         owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                              owl:onDatatype xsd:decimal ;
                                                                                              owl:withRestrictions ( [ xsd:minExclusive "0.0"^^xsd:decimal ]
                                                                                                                     [ xsd:maxExclusive "250.0"^^xsd:decimal ]
                                                                                                                   )
                                                                                            ]
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty :activityScreening ;
                                              owl:hasValue :SPPL
                                            ] ;
                            :source_id "P4:lampiran-i-pangan-sppl" .


###  https://example.org/enviropermit#FoodManufacturingBoundaryAmbiguous
:FoodManufacturingBoundaryAmbiguous rdf:type owl:Class ;
                                    owl:equivalentClass [ owl:intersectionOf ( :FoodManufacturingActivity
                                                                               :LocationClearedForScaleScreening
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasProductionCapacityTonPerYear ;
                                                                                 owl:hasValue "250.0"^^xsd:decimal
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ;
                                    :source_id "P4:lampiran-i-pangan-batas" .


###  https://example.org/enviropermit#FoodManufacturingUklScale
:FoodManufacturingUklScale rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :FoodManufacturingActivity
                                                                      :LocationClearedForScaleScreening
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :hasProductionCapacityTonPerYear ;
                                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                             owl:onDatatype xsd:decimal ;
                                                                                             owl:withRestrictions ( [ xsd:minExclusive "250.0"^^xsd:decimal ]
                                                                                                                    [ xsd:maxExclusive "10000.0"^^xsd:decimal ]
                                                                                                                  )
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :activityScreening ;
                                             owl:hasValue :UKL
                                           ] ;
                           :source_id "P4:lampiran-i-pangan-ukl" .


###  https://example.org/enviropermit#FoodManufacturingAmdalScale
:FoodManufacturingAmdalScale rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( :FoodManufacturingActivity
                                                                        :LocationClearedForScaleScreening
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty :hasProductionCapacityTonPerYear ;
                                                                          owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                               owl:onDatatype xsd:decimal ;
                                                                                               owl:withRestrictions ( [ xsd:minInclusive "10000.0"^^xsd:decimal ] )
                                                                                             ]
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                               owl:onProperty :activityScreening ;
                                               owl:hasValue :AMDAL
                                             ] ;
                             :source_id "P4:lampiran-i-pangan-amdal" .


###  https://example.org/enviropermit#ScenarioWithAmdalActivity
:ScenarioWithAmdalActivity rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :Scenario
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :hasActivity ;
                                                                        owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty :activityScreening ;
                                                                                             owl:hasValue :AMDAL
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasScreening ;
                                             owl:hasValue :AMDAL
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :scenarioObligation ;
                                             owl:hasValue :prepare_amdal
                                           ] ;
                           :source_id "P4:penapisan-industri" .


###  https://example.org/enviropermit#ScenarioWithUklActivity
:ScenarioWithUklActivity rdf:type owl:Class ;
